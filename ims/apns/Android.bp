// Applies ims_apns_overrides.xml (generated by ../tools/gen_carrier_ims.py from the stock
// firmware's IMS APNs) to the AOSP APN list; fails the build if an override no longer matches.
python_binary_host {
    name: "ichthys_ims_apns_merge",
    main: "ims_apns_merge.py",
    srcs: ["ims_apns_merge.py"],
}

// product/etc/apns-conf.xml: TelephonyProvider prefers it over system/etc/apns-conf.xml, so the
// IMS APN fixes ride on top of the unchanged AOSP list.
genrule {
    name: "ichthys_ims_apns_conf_gen",
    srcs: [
        ":sample_apns_conf",
        "ims_apns_overrides.xml",
    ],
    tools: ["ichthys_ims_apns_merge"],
    out: ["apns-conf.xml"],
    cmd: "$(location ichthys_ims_apns_merge) $(location :sample_apns_conf) " +
        "$(location ims_apns_overrides.xml) > $(out)",
}

prebuilt_etc {
    name: "ichthys_ims_apns_conf",
    product_specific: true,
    src: ":ichthys_ims_apns_conf_gen",
    filename: "apns-conf.xml",
}
