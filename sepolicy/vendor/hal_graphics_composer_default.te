get_prop(hal_graphics_composer_default, vendor_mpctl_prop)

# IchthysOS: frame-synced UDFPS mask HBM switch (persist.ichthys.udfps_sync), read per commit
# (also persist.ichthys.udfps_lut_r/_g/_b, the mask tone curve put on the DSPP GC, same type;
# its calibration points udfps_lut1..3_* and the brightness list udfps_lut_bl, same type)
# (also the parametric curve persist.ichthys.udfps_model, persist.ichthys.udfps_sep_keep and
# SystemUI's ichthys.udfps_applied_alpha, same type)
# (also the physics curve's udfps_physics / udfps_gamma / udfps_wb and the mask level
# udfps_mask_level, same type)
# IchthysOS: the curve's brightness comes from /sys/class/backlight/panel0-backlight/brightness,
# which the composer already writes (vendor_sysfs_graphics, rw in sepolicy_vndr common) and reads
# under r_dir_file(hal_graphics_composer_default, sysfs_type): no extra rule needed.
get_prop(hal_graphics_composer_default, ichthys_udfps_prop)

# IchthysOS: the UDFPS mask curve's temperature trim reads the battery temperature once per mask
# session (default persist.ichthys.udfps_tpath = /sys/class/power_supply/battery/temp, a symlink
# into /sys/devices/platform/.../soc:battery/power_supply/battery, sysfs_battery in genfs_contexts).
# The qcom common r_dir_file(hal_graphics_composer_default, sysfs_type) already covers it (and
# thermal_zone nodes); explicit so it survives that broad rule going away.
r_dir_file(hal_graphics_composer_default, sysfs_battery)
