# /sys/class/udc/
allow hal_usb_gadget_default sysfs_udc:dir search;

# /sys/devices/platform/soc/a600000.ssusb/a600000.dwc3/udc/a600000.dwc3/current_speed
allow hal_usb_gadget_default vendor_sysfs_usb_controller:dir search;
allow hal_usb_gadget_default vendor_sysfs_usb_controller:file { read open getattr };

# IchthysOS: MonitorFfs (libpixelusb) inotify-watches /dev/usb-ffs/{adb,mtp,ptp}/ to pull the
# gadget up once adbd / MTP write their descriptors. Without watch, addInotifyFd() fails and
# the HAL rejects every adb/MTP/PTP function request, so USB stayed dead. (tracker#14)
allow hal_usb_gadget_default functionfs:dir { watch watch_reads };
