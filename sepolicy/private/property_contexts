# IchthysOS: frame-synced UDFPS mask HBM (SystemUI + composer + fingerprint HAL), default off.
persist.ichthys.udfps_sync    u:object_r:ichthys_udfps_prop:s0 exact bool
# IchthysOS: per-channel colour gains applied with the UDFPS mask frame (SurfaceFlinger), "r g b".
persist.ichthys.udfps_rgb     u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: UDFPS mask tone curve per channel (display composer, DSPP GC on mask frames only),
# 33 knots x 2 base64url chars = 66 chars each; unset/empty/invalid = no curve.
persist.ichthys.udfps_lut_r   u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut_g   u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut_b   u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: brightness-dependent UDFPS mask curve: calibration points 1..3 (same format as point 0
# above) and persist.ichthys.udfps_lut_bl, the comma list of their screen brightness levels
# (0..255 setting unit, field n = point n). Unset = point 0 alone, as before.
persist.ichthys.udfps_lut1_r  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut1_g  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut1_b  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut2_r  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut2_g  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut2_b  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut3_r  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut3_g  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut3_b  u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_lut_bl  u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: parametric UDFPS mask curve (display composer, used when no knot point above is set):
# persist.ichthys.udfps_model = 12 numbers "a0 a1 p0 p1" per channel r g b; the dim separator's
# keep factor persist.ichthys.udfps_sep_keep (read by SystemUI and the composer, default 252/255);
# ichthys.udfps_applied_alpha = the dim alpha SystemUI applied to the current mask window (not
# persistent, set by SystemUI on every mask, read by the composer).
persist.ichthys.udfps_model     u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_sep_keep  u:object_r:ichthys_udfps_prop:s0 exact string
ichthys.udfps_applied_alpha     u:object_r:ichthys_udfps_prop:s0 exact int
# IchthysOS: physics UDFPS mask curve (composer default when no knot point / model is set; SystemUI
# reads udfps_physics for the same rule): udfps_physics on/off (default on), udfps_gamma (1..4,
# default 2.2), udfps_wb "r g b" (default "1 1 1"); udfps_mask_level = the mask HBM level 256..486
# the composer sends in fingerprint_mask (default 331), also the curve's mask level.
persist.ichthys.udfps_physics     u:object_r:ichthys_udfps_prop:s0 exact bool
persist.ichthys.udfps_gamma       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_wb          u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_mask_level  u:object_r:ichthys_udfps_prop:s0 exact int
# IchthysOS: physics curve exponent p(L) = clamp(p0 + p1 ln L, 0.6, 1), "p0 p1"
# (default "0.787 0.0466").
persist.ichthys.udfps_pexp        u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: physics curve toe lift of the darkest content under the mask HBM, "tr tg tb" (each
# 0..0.05, default "0 0 0" = off), and its knee c1 (0.02..0.5, default 0.1).
persist.ichthys.udfps_toe         u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_toe_knee    u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: toe for a channel lit alone (the other two dark), "tr tg tb" like udfps_toe; unset =
# udfps_toe everywhere (no DSPP 3D gamut stage). Mask frames blend it with udfps_toe per colour.
persist.ichthys.udfps_toe_alone   u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: measured residual on the mask 3D gamut: 375 signed bytes (5x5x5 content nodes x r g b,
# ratio 1 + q * 0.0025, res0..res6) or 1029 (7x7x7, levels 0 8 16 24 48 72 96, res0..res15) as
# base64url, concatenated over res0..res15 (each <= 88 chars); unset / invalid / all zero = no
# residual. udfps_lut_ref.py resprops <residual.json> prints them.
persist.ichthys.udfps_res0        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res1        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res2        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res3        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res4        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res5        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res6        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res7        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res8        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res9        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res10       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res11       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res12       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res13       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res14       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_res15       u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: fine dark-end correction of the physics mask curve per channel: 16 signed bytes
# (multipliers 1 + q * 0.0025 at output y = k * 0.0075) as base64url (22 chars); unset / invalid /
# all zero = none. udfps_lut_ref.py darkprops <dark.json> prints them.
persist.ichthys.udfps_dark_r      u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_dark_g      u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_dark_b      u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: panel PP dither forced to 8 bit while the mask curve is applied (default on; 0 / false
# = leave the colour mode's dither state).
persist.ichthys.udfps_dither      u:object_r:ichthys_udfps_prop:s0 exact string
# IchthysOS: temperature trim of the physics mask curve: read at mask-on from udfps_tpath (absolute
# sysfs path, default /sys/class/power_supply/battery/temp, tenths of a degree C), reference
# temperature udfps_tref (C, default 31), udfps_tcoef "kr kg kb" (fractional multiplier change per
# C, each clamped to +-0.03; unset = no trim).
persist.ichthys.udfps_tpath       u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_tref        u:object_r:ichthys_udfps_prop:s0 exact string
persist.ichthys.udfps_tcoef       u:object_r:ichthys_udfps_prop:s0 exact string
