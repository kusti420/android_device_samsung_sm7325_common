<!-- system uid: SELinux system_app may set sys.abyss.request and persist.abyss.* and read
     /data/misc/abyss/out (abyss_entry.te). The system uid passes most permission checks by uid;
     the permissions are still listed so the intent is visible and nothing depends on that
     shortcut. Privileged ones are allowlisted in privapp-permissions-org.ichthys.abyss.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ichthys.abyss"
    android:sharedUserId="android.uid.system">

    <!-- Go dark before entering (GoDark): double-tap-to-wake is Settings.Secure; airplane mode
         through ConnectivityManager.setAirplaneMode. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Paired Bluetooth headphones in the Settings section. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Wi-Fi hand-over (WifiHandoff): saved networks with passphrases
         (getPrivilegedConfiguredNetworks: READ_WIFI_CREDENTIAL + ACCESS_WIFI_STATE + scan-result
         access), the current connection and scan results (location / nearby devices), the
         country code, the Wi-Fi network's LinkProperties; GoDark switches Wi-Fi off and back on
         when it stays on in airplane mode (CHANGE_WIFI_STATE). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.READ_WIFI_CREDENTIAL" />
    <!-- Put radios and double-tap wake back after Abyss (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_abyss"
        android:label="@string/app_name"
        android:theme="@style/AbyssTheme">

        <!-- The Abyss control center. Also the Settings home page row "Abyss": SettingsLib
             TileUtils loads every SYSTEM app activity that handles IA_SETTINGS (only once setup
             is done, Global.DEVICE_PROVISIONED=1) and files it under the category meta-data;
             ia.homepage is TopLevelSettings. group_key puts it in the IchthysOS group under the
             IchthysOS hub row (packages/apps/Settings res/xml/top_level_settings.xml); keyhint
             is the preference key (needed for the homepage highlight). Settings tints the
             icon, so it is a single-colour glyph. Nothing in packages/apps/Settings changes. -->
        <activity
            android:name=".EntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:priority="1">
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_ichthys_category" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_abyss" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="10" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/settings_tile_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_tile_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_settings_abyss" />
            <meta-data
                android:name="com.android.settings.new_task"
                android:value="true" />
        </activity>

        <!-- Restores what GoDark switched off; clears a stale after_leave. Never opens anything. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Modules (impl-radio-module): Settings › Abyss › Modules. Not exported: reached only
             from the control center; the install sheet only from ModulesActivity's own SAF
             picker result, so no other app can push an install. -->
        <activity
            android:name=".ModulesActivity"
            android:exported="false"
            android:label="@string/mod_title" />
        <activity
            android:name=".ModuleInstallActivity"
            android:exported="false"
            android:label="@string/mod_title" />
        <activity
            android:name=".ModuleSettingsActivity"
            android:exported="false"
            android:label="@string/mod_title" />
    </application>
</manifest>
