<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AbyssTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/abyss_bg</item>
        <item name="android:colorBackground">@color/abyss_bg</item>
        <item name="android:statusBarColor">@color/abyss_bg</item>
        <item name="android:navigationBarColor">@color/abyss_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColor">@color/abyss_text</item>
        <item name="android:textColorPrimary">@color/abyss_text</item>
        <item name="android:textColorSecondary">@color/abyss_dim</item>
        <item name="android:colorAccent">@color/abyss_accent</item>
        <item name="android:colorControlActivated">@color/abyss_accent</item>
        <item name="android:colorControlNormal">@color/abyss_dim</item>
        <item name="android:alertDialogTheme">@style/AbyssDialog</item>
    </style>

    <!-- Dialogs (clear all, capture actions): black, palette text, accent buttons. -->
    <style name="AbyssDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/abyss_bg</item>
        <item name="android:textColorPrimary">@color/abyss_text</item>
        <item name="android:textColor">@color/abyss_text</item>
        <item name="android:textColorSecondary">@color/abyss_dim</item>
        <item name="android:textColorAlertDialogListItem">@color/abyss_text</item>
        <item name="android:colorAccent">@color/abyss_accent</item>
    </style>

    <!-- Section header: small, dim, upper case (canvas boards). -->
    <style name="AbyssSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/abyss_dim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="AbyssCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/outline_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="AbyssHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/abyss_accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A setting's name (row title). -->
    <style name="AbyssLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/abyss_text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="AbyssBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/abyss_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AbyssDim" parent="AbyssBody">
        <item name="android:textColor">@color/abyss_dim</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Big outline button (OLED: no fill), two lines allowed. -->
    <style name="AbyssButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/outline_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/abyss_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Small outline button (captures actions, pair headphones). -->
    <style name="AbyssSmallButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/outline_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/abyss_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Choice chip (Screen stays on). Selected state is set from code. -->
    <style name="AbyssChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/outline_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/abyss_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
