<?xml version="1.0" encoding="utf-8"?>
<!-- Abyss control center: Enter, Captures, Settings, Scripts, Apps & containers.
     Pure black, outlines not fills (DECISIONS "Look"). Rows of the Captures and Bluetooth lists
     are added from EntryActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/abyss_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/abyss_text"
            android:textSize="40sp" />

        <TextView
            style="@style/AbyssDim"
            android:layout_marginTop="8dp"
            android:text="@string/intro" />

        <!-- ENTER ............................................................................ -->
        <TextView style="@style/AbyssSection" android:text="@string/sec_enter" />

        <LinearLayout style="@style/AbyssCard">

            <TextView
                style="@style/AbyssBody"
                android:layout_marginTop="0dp"
                android:text="@string/deep_body" />

            <TextView style="@style/AbyssHeading" android:text="@string/stops_heading" />
            <TextView style="@style/AbyssBody" android:text="@string/stops_body" />

            <TextView style="@style/AbyssHeading" android:text="@string/keeps_heading" />
            <TextView style="@style/AbyssBody" android:text="@string/keeps_body" />

            <TextView style="@style/AbyssHeading" android:text="@string/back_heading" />
            <TextView style="@style/AbyssBody" android:text="@string/back_body" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="14dp"
                android:text="@string/lite_note" />

            <TextView
                android:id="@+id/headphones"
                style="@style/AbyssBody"
                android:layout_marginTop="14dp"
                android:text="@string/no_headphones"
                android:textColor="@color/abyss_warn"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                style="@style/AbyssBody"
                android:layout_marginTop="12dp"
                android:textColor="@color/abyss_warn"
                android:visibility="gone" />

            <Button
                android:id="@+id/enter"
                style="@style/AbyssButton"
                android:layout_marginTop="18dp"
                android:text="@string/enter" />
        </LinearLayout>

        <!-- CAPTURES ......................................................................... -->
        <TextView
            android:id="@+id/captures_header"
            style="@style/AbyssSection"
            android:text="@string/sec_captures" />

        <LinearLayout style="@style/AbyssCard">

            <TextView
                android:id="@+id/captures_info"
                style="@style/AbyssDim"
                android:layout_marginTop="0dp" />

            <LinearLayout
                android:id="@+id/captures_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/captures_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/captures_share_all"
                    style="@style/AbyssSmallButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/captures_share_all" />

                <Button
                    android:id="@+id/captures_save_file"
                    style="@style/AbyssSmallButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/captures_save_file" />

                <Button
                    android:id="@+id/captures_clear_all"
                    style="@style/AbyssSmallButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/captures_clear_all"
                    android:textColor="@color/abyss_warn" />
            </LinearLayout>
        </LinearLayout>

        <!-- SETTINGS ......................................................................... -->
        <TextView style="@style/AbyssSection" android:text="@string/sec_settings" />

        <LinearLayout style="@style/AbyssCard">

            <!-- Brightness: persist.abyss.brightness 1..486 -->
            <TextView style="@style/AbyssLabel" android:text="@string/brightness_title" />

            <TextView
                android:id="@+id/brightness_value"
                style="@style/AbyssDim"
                android:layout_marginTop="2dp" />

            <SeekBar
                android:id="@+id/brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:min="1"
                android:max="486"
                android:progressTint="@color/abyss_accent"
                android:progressBackgroundTint="@color/abyss_outline"
                android:thumbTint="@color/abyss_accent" />

            <!-- Screen stays on: persist.abyss.screen_timeout_s -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/abyss_rule" />

            <TextView
                style="@style/AbyssLabel"
                android:layout_marginTop="16dp"
                android:text="@string/screen_timeout_title" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="2dp"
                android:text="@string/screen_timeout_summary" />

            <LinearLayout
                android:id="@+id/screen_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/screen_timeout_other"
                style="@style/AbyssDim"
                android:visibility="gone" />

            <!-- Navigation: persist.abyss.nav.start (player | home); abyssd ui.rs NavPrefs,
                 read on entry -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/abyss_rule" />

            <TextView
                style="@style/AbyssLabel"
                android:layout_marginTop="16dp"
                android:text="@string/nav_start_title" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="2dp"
                android:text="@string/nav_start_summary" />

            <LinearLayout
                android:id="@+id/nav_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="10dp"
                android:text="@string/nav_keys_note" />

            <!-- Deep sleep: persist.abyss.suspend 0/1 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/abyss_rule" />

            <LinearLayout
                android:id="@+id/suspend_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/AbyssLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/suspend_title" />

                <Switch
                    android:id="@+id/suspend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/abyss_text"
                    android:trackTint="@color/abyss_outline" />
            </LinearLayout>

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="2dp"
                android:text="@string/suspend_summary"
                android:textColor="@color/abyss_warn" />

            <!-- Volume limit: information only (abyssd: 200 steps, warn above 140) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/abyss_rule" />

            <TextView
                style="@style/AbyssLabel"
                android:layout_marginTop="16dp"
                android:text="@string/volume_title" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="2dp"
                android:text="@string/volume_summary" />

            <!-- Bluetooth headphones: Android's bonded audio devices + out/bt_last.json -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/abyss_rule" />

            <TextView
                style="@style/AbyssLabel"
                android:layout_marginTop="16dp"
                android:text="@string/bt_title" />

            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="2dp"
                android:text="@string/bt_summary" />

            <LinearLayout
                android:id="@+id/bt_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/bt_open_settings"
                style="@style/AbyssSmallButton"
                android:layout_marginTop="12dp"
                android:text="@string/bt_open_settings" />

            <TextView
                android:id="@+id/settings_error"
                style="@style/AbyssBody"
                android:layout_marginTop="12dp"
                android:textColor="@color/abyss_warn"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SCRIPTS (v1.1) ..................................................................... -->
        <TextView style="@style/AbyssSection" android:text="@string/sec_scripts" />

        <LinearLayout
            style="@style/AbyssCard"
            android:background="@drawable/outline_dashed">

            <TextView
                android:id="@+id/scripts_tag"
                style="@style/AbyssDim"
                android:layout_marginTop="0dp"
                android:textColor="@color/abyss_warn" />

            <TextView
                style="@style/AbyssBody"
                android:text="@string/scripts_body"
                android:textColor="@color/abyss_dim" />

            <TextView
                android:id="@+id/docs_scripts"
                style="@style/AbyssDim"
                android:layout_marginTop="10dp"
                android:text="@string/docs_scripts" />
        </LinearLayout>

        <!-- APPS & CONTAINERS (v1.2) ........................................................... -->
        <TextView style="@style/AbyssSection" android:text="@string/sec_apps" />

        <LinearLayout
            style="@style/AbyssCard"
            android:background="@drawable/outline_dashed">

            <TextView
                android:id="@+id/apps_tag"
                style="@style/AbyssDim"
                android:layout_marginTop="0dp"
                android:textColor="@color/abyss_warn" />

            <TextView
                style="@style/AbyssBody"
                android:text="@string/apps_body"
                android:textColor="@color/abyss_dim" />

            <TextView
                android:id="@+id/docs_apps"
                style="@style/AbyssDim"
                android:layout_marginTop="10dp"
                android:text="@string/docs_apps" />

            <!-- Modules (impl-radio-module): Settings › Abyss › Modules, ModulesActivity. -->
            <TextView
                style="@style/AbyssDim"
                android:layout_marginTop="16dp"
                android:text="@string/mod_open_hint" />

            <Button
                android:id="@+id/modules_open"
                style="@style/AbyssSmallButton"
                android:layout_marginTop="10dp"
                android:text="@string/mod_open" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
