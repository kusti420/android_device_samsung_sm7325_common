<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window: the theme card with a hairline, inset like the platform dialog background. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/abyss_card" />
        <stroke android:width="1dp" android:color="@color/abyss_rule" />
        <corners android:radius="@*android:dimen/ichthys_radius" />
    </shape>
</inset>
