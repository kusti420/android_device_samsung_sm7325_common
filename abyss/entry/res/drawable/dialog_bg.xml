<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window: black with the card outline, inset like the platform dialog background. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/abyss_bg" />
        <stroke android:width="1dp" android:color="@color/abyss_outline" />
        <corners android:radius="12dp" />
    </shape>
</inset>
