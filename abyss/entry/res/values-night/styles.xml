<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: the dark DeviceDefault parents and light status / navigation bar icons. The
     theme items themselves are in values/styles.xml (AbyssTheme, AbyssDialog). -->
<resources>
    <style name="AbyssBase" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AbyssDialogBase" parent="@android:style/Theme.DeviceDefault.Dialog.Alert" />
</resources>
